# SQLite for local/dev. Switch to Postgres later by changing the Prisma
# datasource provider to "postgresql" and pointing this URL at your server.
# Example Postgres: postgresql://USER:PASSWORD@HOST:5432/chilakil_owner
DATABASE_URL="file:./dev.db"

# Required. Used to sign the owner session cookie (JWT).
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Alias accepted by the app (same value as AUTH_SECRET).
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Public URL of the app (used in metadata / future OAuth).
APP_URL="http://localhost:3000"

# Seeded owner login. Override before any non-local use.
OWNER_EMAIL="owner@chilakil.com"
OWNER_PASSWORD="ChilakilOwner1!"
OWNER_NAME="Chilakil Owner"

# Optional. If unset, the AI Assistant uses deterministic local analysis of
# the SQLite database (no live platform API calls either way).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Future integrations — Phase 1 stores these as secret *names* only.
# Do not put live credentials in the database. Leave blank until Phase 2.
# ---------------------------------------------------------------------------

# Glendale Restaurant
DOORDASH_GLENDALE_API_KEY=""
DOORDASH_GLENDALE_STORE_ID=""

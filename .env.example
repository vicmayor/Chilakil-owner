# Postgres. Local docker-compose (see docker-compose.yml) uses the same URL
# for both. On Neon via the Vercel Marketplace, DATABASE_URL is the pooled
# connection and DIRECT_URL is the unpooled / direct connection
# (often named DATABASE_URL_UNPOOLED or POSTGRES_URL_NON_POOLING).
DATABASE_URL="postgresql://chilakil:chilakil@localhost:5432/chilakil_owner"
DIRECT_URL="postgresql://chilakil:chilakil@localhost:5432/chilakil_owner"

# Required. Used to sign the owner session cookie (JWT).
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Alias accepted by the app (same value as AUTH_SECRET).
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Required for the sales / DoorDash ingest API (Authorization: Bearer ...).
# Generate with: openssl rand -base64 32
INGEST_TOKEN="replace-with-a-long-random-string"

# Public URL of the app. The ingest CLI posts here when INGEST_BASE_URL is unset.
APP_URL="http://localhost:3000"

# Owner account created by `npx prisma db seed`. Both are required.
# There is no built-in password. Do not reuse a local password in production.
OWNER_EMAIL="owner@chilakil.com"
OWNER_PASSWORD=""
OWNER_NAME="Victor Mayorga"

# Set to true only for a local demo. Leave unset or false in production.
SEED_SAMPLE="false"

# Optional. If unset, the AI Assistant uses deterministic local analysis
# (no live platform API calls either way).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Future integrations — Phase 1 stores these as secret *names* only.
# Do not put live credentials in the database. Leave blank until Phase 2.
# ---------------------------------------------------------------------------

# Glendale Restaurant
DOORDASH_GLENDALE_API_KEY=""
DOORDASH_GLENDALE_STORE_ID=""
UBEREATS_GLENDALE_CLIENT_ID=""
UBEREATS_GLENDALE_CLIENT_SECRET=""
UBEREATS_GLENDALE_STORE_ID=""
GRUBHUB_GLENDALE_API_KEY=""
GRUBHUB_GLENDALE_STORE_ID=""
SQUARE_GLENDALE_ACCESS_TOKEN=""
SQUARE_GLENDALE_LOCATION_ID=""
META_GLENDALE_PAGE_TOKEN=""
BANKING_GLENDALE_SECRET_REF=""


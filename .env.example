UBEREATS_GLENDALE_STORE_ID=""
GRUBHUB_GLENDALE_API_KEY=""
GRUBHUB_GLENDALE_STORE_ID=""
SQUARE_GLENDALE_ACCESS_TOKEN=""
SQUARE_GLENDALE_LOCATION_ID=""
# Paid ads APIs are Phase 2. Store the *name* in IntegrationConfig, never the token.
META_GLENDALE_ACCESS_TOKEN=""
GOOGLE_ADS_GLENDALE_ACCESS_TOKEN=""
TIKTOK_GLENDALE_ACCESS_TOKEN=""
BANKING_GLENDALE_SECRET_REF=""


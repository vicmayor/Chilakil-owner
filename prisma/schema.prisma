generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Postgres for local docker-compose and hosted Neon.
// DATABASE_URL is the runtime connection (use the Neon pooled URL on Vercel).
// DIRECT_URL is the direct connection Prisma Migrate uses (Neon unpooled URL).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("owner")
  createdAt    DateTime @default(now())
}

/// Independently tracked operation. Never share financial rows across locations.
model Location {
  id        String @id
  name      String
  shortName String
  type      String // restaurant | trailer
  timezone  String
  address   String?
  city      String?
  phone     String?

  orders             Order[]
  dailySales         DailySales[]
  deliverySummaries  DeliverySummary[]
  dailyOps           DailyOps[]
  expenses           Expense[]
  ingredients        Ingredient[]
  recipes            Recipe[]
  menuItems          MenuItem[]
  messages           CustomerMessage[]
  reviews            Review[]
  campaigns          MarketingCampaign[]
  employees             Employee[]
  shifts                Shift[]
  employeeHoursPeriods  EmployeeHoursPeriod[]
  teamInventoryItems    TeamInventoryItem[]
  teamInventorySummary  TeamInventorySummary?
  integrations          IntegrationConfig[]
  alerts                Alert[]
  dailySalesRecords     DailySalesRecord[]
  doorDashWeeklyReports DoorDashWeeklyReport[]
  uberEatsWeeklyReports UberEatsWeeklyReport[]
  pricingReports        DoorDashPricingReport[]
  foodCostProfile       FoodCostProfile?
}

model Order {
  id          String   @id @default(cuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  channel     String // in_store | doordash | ubereats | grubhub | other
  orderedAt   DateTime
  gross       Float
  fees        Float
  net         Float
  guestName   String?
  itemSummary String?

  @@index([locationId, orderedAt])
  @@index([locationId, channel])
}

model DailySales {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  date       String // YYYY-MM-DD in America/Phoenix
  channel    String
  gross      Float
  fees       Float
  net        Float
  orderCount Int

  @@unique([locationId, date, channel])
  @@index([locationId, date])
}

model DeliverySummary {
  id              String   @id @default(cuid())
  locationId      String
  location        Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  platform        String // doordash | ubereats | grubhub
  date            String
  orderCount      Int
  gross           Float
  commission      Float
  otherFees       Float
  net             Float
  avgPrepMinutes  Float?
  cancelledOrders Int      @default(0)
  refunds         Float    @default(0)

  @@unique([locationId, platform, date])
  @@index([locationId, date])
}

model DailyOps {
  id                    String   @id @default(cuid())
  locationId            String
  location              Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  date                  String
  laborHours            Float
  laborCost             Float
  theoreticalFoodCost   Float
  actualFoodPurchases   Float
  targetLaborPct        Float
  targetFoodCostPct     Float

  @@unique([locationId, date])
}

model Expense {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  category   String
  amount     Float
  date       String
  vendor     String
  notes      String?
  recurring  Boolean  @default(false)

  @@index([locationId, date])
}

model Ingredient {
  id                String             @id @default(cuid())
  locationId        String
  location          Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name              String
  unit              String
  /// Null when the workbook purchase cost is blank. Never treat a blank cell as $0.
  costPerUnit       Float?
  onHand            Float
  reorderPoint      Float
  vendor            String?
  purchaseQty       Float?
  purchaseCost      Float?
  /// Yield as a ratio. 1 = 100%.
  yieldPct          Float?
  addonPrice        Float?
  portionQty        Float?
  notes             String?
  sourceKey         String?
  sortOrder         Int                @default(0)
  isStandardTopping Boolean            @default(false)
  recipeLines       RecipeIngredient[]

  @@unique([locationId, sourceKey])
}

model Recipe {
  id                String             @id @default(cuid())
  locationId        String
  location          Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name              String
  yieldQty          Float              @default(1)
  yieldUnit         String             @default("serving")
  notes             String?
  packagingCost     Float              @default(0)
  standardToppings  Boolean            @default(false)
  sourceKey         String?
  sortOrder         Int                @default(0)
  ingredients       RecipeIngredient[]
  menuItems         MenuItem[]

  @@unique([locationId, sourceKey])
}

model RecipeIngredient {
  id            String     @id @default(cuid())
  recipeId      String
  recipe        Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId  String
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity      Float
  sortOrder     Int        @default(0)
  notes         String?
  /// Recipe-sheet unit cost, including an explicit 0 when the sheet line is $0.
  sheetUnitCost Float?
  /// component | average_protein | packaging
  kind          String     @default("component")
}

model MenuItem {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  category   String
  /// Null when the workbook has no entered sell price.
  price      Float?
  recipeId   String?
  recipe     Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  active     Boolean  @default(true)
  sourceKey  String?
  sortOrder  Int      @default(0)

  @@unique([locationId, sourceKey])
}

/// Sheet-level food cost settings for one location. Upserted with the workbook.
model FoodCostProfile {
  id                String   @id @default(cuid())
  locationId        String   @unique
  location          Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  targetFoodCostPct Float
  caveat            String?
  workbook          String
  updatedAt         DateTime @updatedAt
}

model CustomerMessage {
  id                     String   @id @default(cuid())
  locationId             String
  location               Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  platform               String
  customerName           String
  language               String // en | es
  body                   String
  receivedAt             DateTime
  status                 String // new | pending_approval | approved | rejected | sent
  category               String // general | complaint | refund | allergy | catering | other
  sensitive              Boolean
  requiresOwnerApproval  Boolean
  sensitivityFlags       String // JSON string array
  draftReply             String?
  approvedReply          String?
  ownerNote              String?
}

model Review {
  id           String   @id @default(cuid())
  locationId   String
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  platform     String
  rating       Int
  author       String
  text         String
  reviewedAt   DateTime
  responded    Boolean  @default(false)
  responseText String?
}

model MarketingCampaign {
  id         String    @id @default(cuid())
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  name       String
  channel    String
  status     String
  startDate  String
  endDate    String?
  spend      Float
  impressions Int?
  clicks     Int?
  notes      String?
}

model Employee {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  role       String
  hourlyRate Float
  active     Boolean  @default(true)
  phone      String?
  shifts     Shift[]
}

model Shift {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  date       String
  startTime  String
  endTime    String
  hours      Float
  laborCost  Float
  role       String
}

enum EmployeeHoursStatus {
  pending
  approved
}

/// One employee at one location for one Sunday–Saturday pay period.
/// Pulled from the Chilakil Team API. Keyed by employee id, so the same
/// person can have a row at Glendale and a row at Avondale.
/// Dates are America/Phoenix calendar days. This app does not edit or approve these rows.
/// status is the Team period approval, which covers both locations.
/// grossPayEstimate is stored as Team sent it. hourlyRate is the current rate only.
model EmployeeHoursPeriod {
  id                 String                     @id @default(cuid())
  locationId         String
  location           Location                   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  periodStart        String
  periodEnd          String
  employeeId         String
  employeeName       String
  hourlyRate         Decimal                    @db.Decimal(10, 2)
  totalHours         Decimal                    @db.Decimal(14, 6)
  grossPayEstimate   Decimal                    @db.Decimal(10, 2)
  status             EmployeeHoursStatus
  syncedAt           DateTime                   @default(now())
  days               EmployeeHoursDay[]
  appliedHourlyRates EmployeeHoursAppliedRate[]
  openShifts         EmployeeHoursOpenShift[]

  @@unique([locationId, periodStart, employeeId])
  @@index([locationId, periodStart])
}

/// One shift segment on one date. A night shift can share shiftId across dates.
/// Several segments can share a date. Hours keep up to six decimals.
/// unpaidBreakMinutes is already deducted from hours.
model EmployeeHoursDay {
  id                  String               @id @default(cuid())
  periodId            String
  period              EmployeeHoursPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  shiftId             String
  date                String
  clockIn             String?
  clockOut            String?
  hours               Decimal              @db.Decimal(14, 6)
  hourlyRate          Decimal              @db.Decimal(10, 2)
  unpaidBreakMinutes  Int
  breakTimesRecorded  Boolean
  breaks              EmployeeHoursBreak[]

  @@unique([periodId, shiftId, date])
  @@index([periodId, date])
}

/// Historical rates Team used for grossPayEstimate. Not the current rate.
model EmployeeHoursAppliedRate {
  id         String              @id @default(cuid())
  periodId   String
  period     EmployeeHoursPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  hourlyRate Decimal             @db.Decimal(10, 2)
  sortOrder  Int                 @default(0)

  @@index([periodId, sortOrder])
}

/// Open shift listed by Team, including a clock-in from before this week.
/// Hours stay on the segment as 0 and are not counted.
model EmployeeHoursOpenShift {
  id       String              @id @default(cuid())
  periodId String
  period   EmployeeHoursPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  shiftId  String
  clockIn  String

  @@unique([periodId, shiftId])
}

/// Last Team hours sync. A failed pull leaves lastSuccessAt and the hour rows in place.
model TeamHoursSyncState {
  id            String    @id
  lastSuccessAt DateTime?
  lastError     String?
  lastErrorAt   DateTime?
}

/// Current Team inventory row. Identity is location + item id, never the name.
/// quantityOnHand is already in base units. Null means unknown, not zero.
model TeamInventoryItem {
  id              String   @id @default(cuid())
  locationId      String
  location        Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  itemId          String
  name            String
  nameEn          String
  category        String
  unit            String?
  unitLabel       String?
  supplier        String?
  quantityOnHand  Decimal? @db.Decimal(14, 3)
  status          String
  lowStock        Boolean
  parLevel        Decimal? @db.Decimal(14, 3)
  minimumLevel    Decimal? @db.Decimal(14, 3)
  unitCost        Decimal? @db.Decimal(12, 2)
  purchase        String?
  deliveryStatus  String?
  neededBy        String?
  neededDate      String?
  lastCountedAt   String?
  lastCountedBy   String?
  lastUpdatedAt   String?
  lastUpdatedBy   String?
  syncedAt        DateTime @default(now())

  @@unique([locationId, itemId])
  @@index([locationId, status])
}

/// Summary counters Team sent for one location. They overlap and are not exclusive.
model TeamInventorySummary {
  locationId  String   @id
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  out         Int
  low         Int
  toBuy       Int
  onTheWay    Int
  unreviewed  Int
  generatedAt DateTime
  syncedAt    DateTime @default(now())
}

/// Last Team inventory sync. A failed pull leaves lastSuccessAt, generatedAt, and the rows in place.
model TeamInventorySyncState {
  id            String    @id
  lastSuccessAt DateTime?
  lastError     String?
  lastStatus    Int?
  generatedAt   DateTime?
}

model EmployeeHoursBreak {
  id        String           @id @default(cuid())
  dayId     String
  day       EmployeeHoursDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  start     String
  end       String
  sortOrder Int              @default(0)

  @@index([dayId, sortOrder])
}

/// Stores secret *references* (env var names), never secret values.
model IntegrationConfig {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  provider   String
  status     String // placeholder | connected | disconnected
  secretRef  String
  storeRef   String?
  notes      String?

  @@unique([locationId, provider])
}

model Alert {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type       String
  severity   String // info | warning | critical
  title      String
  body       String
  date       String
  href       String?
  read       Boolean  @default(false)
}

model AiThread {
  id            String      @id @default(cuid())
  title         String
  locationScope String
  createdAt     DateTime    @default(now())
  messages      AiMessage[]
}

model AiMessage {
  id        String   @id @default(cuid())
  threadId  String
  thread    AiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())
}

/// One imported sales day for a single location. Phoenix calendar date.
/// Idempotent on location + date. Channel columns are optional.
model DailySalesRecord {
  id            String   @id @default(cuid())
  locationId    String
  location      Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  date          String // YYYY-MM-DD in America/Phoenix
  grossSales    Float
  netSales      Float
  discounts     Float    @default(0)
  refunds       Float    @default(0)
  tips          Float    @default(0)
  tax           Float?
  orderCount    Int
  averageTicket Float
  inStoreGross  Float?
  inStoreOrders Int?
  doorDashGross Float?
  doorDashOrders Int?
  uberEatsGross Float?
  uberEatsOrders Int?
  grubhubGross  Float?
  grubhubOrders Int?
  source        String
  importedAt    DateTime @default(now())

  @@unique([locationId, date])
  @@index([locationId, date])
}

/// One DoorDash merchant week for a single location.
/// Glendale store 32669627, Avondale store 27859030.
/// Idempotent on location + week start. effectiveCommissionPct is a ratio (0.30 = 30%).
model DoorDashWeeklyReport {
  id                     String   @id @default(cuid())
  locationId             String
  location               Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  doorDashStoreId        String
  weekStart              String // YYYY-MM-DD
  weekEnd                String // YYYY-MM-DD, inclusive
  subtotal               Float
  gross                  Float
  orderCount             Int
  commission             Float
  marketingFees          Float    @default(0)
  errorCharges           Float    @default(0)
  adjustments            Float    @default(0)
  netPayout              Float
  effectiveCommissionPct Float
  deliveryOrders         Int?
  pickupOrders           Int?
  deliverySubtotal       Float?
  pickupSubtotal         Float?
  source                 String
  importedAt             DateTime @default(now())

  @@unique([locationId, weekStart])
  @@index([locationId, weekStart])
}

/// One Uber Eats merchant week for a single location.
/// Glendale store 91bb8a8e-e9c5-5c0d-88a0-671cb75faf20.
/// Avondale store a4232345-3850-5bb6-92bf-27434a445d64 (Uber may label this store Phoenix).
/// Idempotent on location + week start.
/// Statement deductions keep their sign. errorCharges stays null when the statement has none.
model UberEatsWeeklyReport {
  id             String   @id @default(cuid())
  locationId     String
  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  uberStoreId    String
  weekStart      String // YYYY-MM-DD
  weekEnd        String // YYYY-MM-DD, inclusive
  subtotal       Float
  tax            Float
  gross          Float
  orderCount     Int
  deliveryOrders Int
  pickupOrders   Int
  commission     Float
  marketingFees  Float
  promoFees      Float
  adjustments    Float
  errorCharges   Float?
  netPayout      Float
  source         String
  importedAt     DateTime @default(now())

  @@unique([locationId, weekStart])
  @@index([locationId, weekStart])
}

/// One DoorDash vs in-store pricing report for a single location and date.
/// Keyed so later report dates can be added without mixing stores.
model DoorDashPricingReport {
  id              String   @id @default(cuid())
  locationId      String
  location        Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  reportDate      String // YYYY-MM-DD
  doorDashStoreId String
  title           String
  headline        String
  summary         String
  commissionRate  Float
  commissionNote  String
  exclusionNote   String
  methodNote      String
  addonNote       String?
  addonNoteTone   String? // review | info
  popularityLead  String
  tenOrderExample String
  pdfPath         String?
  lines           DoorDashPricingLine[]
  notes           DoorDashPricingNote[]

  @@unique([locationId, reportDate, doorDashStoreId])
  @@index([locationId, reportDate])
}

/// Menu item or add-on row from a pricing report. Read-only; nothing here changes DoorDash.
model DoorDashPricingLine {
  id                String                 @id @default(cuid())
  reportId          String
  report            DoorDashPricingReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  kind              String // item | addon
  sortOrder         Int
  name              String
  inStorePrice      Float
  doorDashPrice     Float?
  onDoorDash        Boolean                @default(true)
  markupPct         Float?
  keepNow           Float?
  vsInStore         Float?
  breakEvenPrice    Float?
  recommendedPrice  Float?
  changeNeeded      Float?
  keepRecommended   Float?
  status            String // losing | ok | review | not_on_menu
  footnote          String?
  squareSold30d     Int?

  @@index([reportId, kind, sortOrder])
}

model DoorDashPricingNote {
  id        String                @id @default(cuid())
  reportId  String
  report    DoorDashPricingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sortOrder Int
  kind      String // check | commission | exclusion | info
  body      String

  @@index([reportId, sortOrder])
}
